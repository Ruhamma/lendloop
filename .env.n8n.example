# Copy to .env.n8n (git-ignored). Generate secrets with: openssl rand -hex 32

# Convex HTTP actions URL (ends in .convex.site for a cloud deployment).
# Local Convex (npx convex dev without a cloud project): http://host.docker.internal:3211
CONVEX_SITE_URL=https://your-deployment.convex.site

# Must match the same-named Convex env vars (npx convex env set ...).
CONVEX_TO_N8N_SECRET=
N8N_TO_CONVEX_SECRET=

# Optional: Slack/Discord incoming webhook for failure alerts from the error workflow.
ALERT_WEBHOOK_URL=

GENERIC_TIMEZONE=UTC
